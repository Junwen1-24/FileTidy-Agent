# Local server. Keep the default loopback host unless you understand the risk
# of exposing a filesystem-capable service on your network.
HOST=127.0.0.1
PORT=4310

# Optional absolute path. Defaults to ./.filetidy-data
FILETIDY_DATA_DIR=

# Safety/performance limits for one scan.
FILETIDY_MAX_FILES=1000
FILETIDY_MAX_DEPTH=8
